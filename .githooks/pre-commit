#!/bin/sh
# Pre-commit hook wrapper to run PowerShell BOM check
ROOT="$(git rev-parse --show-toplevel)"
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$ROOT/scripts/precommit-check.ps1" || exit 1
else
  powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$ROOT/scripts/precommit-check.ps1" || exit 1
fi
exit 0
